datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id Int @id @default(autoincrement())
  nome String
  email String @unique
  senha String
  tipoUsuario String
  documento String
  curriculoUrl String?
  vagas Job[]
  @@map("users")
}

model Job {
  id Int @id @default(autoincrement())
  titulo String
  descricao String
  salario Float
  localizacao String
  status String @default("ativa")
  criadoEm DateTime @default(now())
  empresaId Int
  empresa User @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("jobs")
}